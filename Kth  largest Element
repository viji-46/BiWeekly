import java.util.*;

class Solution {
    int solve(ArrayList<Integer> nums, int k) {
        for(int i=0;i<nums.size();i++)
        {
             int max=Integer.MIN_VALUE;
             int index=-1;
            for(int j=0;j<nums.size();j++)
            {
                if(nums.get(j)>max)
                {
                    max=nums.get(j);
                    index=j;
                }
            }
            if(i==k-1)
            {
                return max;
            }
            else{
                nums.remove(index);
            }
        }
        return -1;
    }
}
